|0100
test_opt_across_empty_if
BRK

@test_opt_across_empty_if
    #08 #07 #08 #07
    #2a ;&x STA
    ( start IF )
    #01 ADD EQU 
    ?&if-true
    &if-false
        SWP
        MUL ( 56 )
        ( DUP
        #38 EQU ?&if-true3
        &if-false3
            LIT "f #18 DEO
        !&end-if3
        ( ,&end-if JMP )
        &if-true3 
            LIT "t #18 DEO        
        !&end-if3
        &end-if3 )
        ( LIT "a #18 DEO )

    !&end-if
    ( ,&end-if JMP )
    &if-true 
        MUL ( 56 )
        INC #01 SUB
        DUP
        #38 EQU ?&if-true2
        &if-false2
            LIT "F #18 DEO
        !&end-if2
        ( ,&end-if JMP )
        &if-true2 
            LIT "T #18 DEO        
        !&end-if2
        &end-if2
        ( LIT "A #18 DEO )

    !&end-if
    &end-if
    #01
    SWP
    ( end IF )
    ;&x LDA ( 42 )
    SUB ( 56-42 = 14 )
    MUL
    #03 MUL #18 DEO #0a18 DEO
JMP2r
&x $1
